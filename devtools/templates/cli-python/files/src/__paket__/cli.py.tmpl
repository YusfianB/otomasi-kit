"""Command-line interface for {{ judul }}."""

from __future__ import annotations

import argparse
import json
import logging
import sys
from pathlib import Path

from {{ paket }} import __version__
from {{ paket }}.config import ConfigError, load_config
from {{ paket }}.core import count_file, greet

log = logging.getLogger("{{ paket }}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="{{ slug }}",
        description={{ deskripsi | tojson }},
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    parser.add_argument("-c", "--config", help="Path file config TOML")
    parser.add_argument("-v", "--verbose", action="store_true", help="Log detail (DEBUG)")
    parser.add_argument("-q", "--quiet", action="store_true", help="Hanya peringatan & error")
    sub = parser.add_subparsers(dest="perintah", metavar="PERINTAH")

    p = sub.add_parser("sapa", help="Tampilkan sapaan")
    p.add_argument("nama")
    p.add_argument("-n", "--ulang", type=int, default=1, help="Jumlah pengulangan")

    p = sub.add_parser("hitung", help="Hitung baris/kata/karakter file teks")
    p.add_argument("file", nargs="+", type=Path)
    p.add_argument("--json", action="store_true", help="Output JSON")

    sub.add_parser("config", help="Tampilkan config yang sedang dipakai")
    return parser


def setup_logging(level_name: str, verbose: bool, quiet: bool, log_file: str = "") -> None:
    level = logging.DEBUG if verbose else logging.WARNING if quiet else level_name.upper()
    handlers: list[logging.Handler] = [logging.StreamHandler(sys.stderr)]
    if log_file:
        handlers.append(logging.FileHandler(log_file, encoding="utf-8"))
    logging.basicConfig(
        level=level,
        format="%(asctime)s %(levelname)-7s %(name)s: %(message)s",
        handlers=handlers,
        force=True,
    )


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        config, config_path = load_config(args.config)
    except ConfigError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    setup_logging(config["log"]["level"], args.verbose, args.quiet, config["log"].get("file", ""))
    log.debug("config: %s", config_path or "(bawaan)")

    if args.perintah == "sapa":
        try:
            for line in greet(args.nama, config["sapaan"], args.ulang):
                print(line)
        except ValueError as exc:
            log.error("%s", exc)
            return 1
        return 0

    if args.perintah == "hitung":
        results = []
        for path in args.file:
            if not path.is_file():
                log.error("File tidak ditemukan: %s", path)
                return 1
            results.append(count_file(path))
        if args.json:
            print(json.dumps([
                {"file": str(r.path), "baris": r.lines, "kata": r.words, "karakter": r.chars}
                for r in results
            ], indent=2))
        else:
            for r in results:
                print(f"{r.lines:>8} {r.words:>8} {r.chars:>8}  {r.path}")
        return 0

    if args.perintah == "config":
        print(f"# sumber: {config_path or '(bawaan)'}")
        print(json.dumps(config, indent=2, ensure_ascii=False))
        return 0

    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
