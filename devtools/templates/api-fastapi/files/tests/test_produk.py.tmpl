def _buat(client, **kw):
    data = {"nama": "Kopi Gayo", "harga": 85000, "stok": 10, **kw}
    resp = client.post("/produk", json=data)
    assert resp.status_code == 201, resp.text
    return resp.json()


def test_root_dan_kesehatan(client):
    assert client.get("/kesehatan").json() == {"status": "ok"}
    assert client.get("/").json()["dokumentasi"] == "/docs"


def test_buat_dan_ambil(client):
    item = _buat(client)
    assert item["id"] == 1
    resp = client.get(f"/produk/{item['id']}")
    assert resp.status_code == 200
    assert resp.json()["nama"] == "Kopi Gayo"


def test_daftar_dan_cari(client):
    _buat(client, nama="Kopi Gayo")
    _buat(client, nama="Teh Melati", harga=20000)
    semua = client.get("/produk").json()
    assert semua["total"] == 2 and len(semua["data"]) == 2
    hasil = client.get("/produk", params={"q": "teh"}).json()
    assert hasil["total"] == 1 and hasil["data"][0]["nama"] == "Teh Melati"


def test_patch_dan_put(client):
    item = _buat(client)
    resp = client.patch(f"/produk/{item['id']}", json={"stok": 3})
    assert resp.status_code == 200 and resp.json()["stok"] == 3
    assert resp.json()["harga"] == 85000
    resp = client.put(f"/produk/{item['id']}", json={"nama": "Kopi Toraja", "harga": 90000})
    assert resp.json()["nama"] == "Kopi Toraja" and resp.json()["stok"] == 0


def test_hapus(client):
    item = _buat(client)
    assert client.delete(f"/produk/{item['id']}").status_code == 204
    assert client.get(f"/produk/{item['id']}").status_code == 404
    assert client.delete(f"/produk/{item['id']}").status_code == 404


def test_validasi(client):
    assert client.post("/produk", json={"nama": "", "harga": 1}).status_code == 422
    assert client.post("/produk", json={"nama": "X", "harga": -5}).status_code == 422
    assert client.get("/produk/123").status_code == 404
