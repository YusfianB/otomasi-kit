"""SQLite storage using only the standard library ``sqlite3`` module.

This module has no FastAPI/pydantic imports so it can be tested and reused on its own.
"""

from __future__ import annotations

import sqlite3
from collections.abc import Iterator
from contextlib import contextmanager
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

SCHEMA = """
CREATE TABLE IF NOT EXISTS produk (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    nama        TEXT    NOT NULL,
    deskripsi   TEXT,
    harga       INTEGER NOT NULL CHECK (harga >= 0),
    stok        INTEGER NOT NULL DEFAULT 0 CHECK (stok >= 0),
    dibuat      TEXT    NOT NULL,
    diperbarui  TEXT    NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_produk_nama ON produk (nama);
"""

FIELDS = ("nama", "deskripsi", "harga", "stok")


def _now() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds")


def connect(path: str | Path) -> sqlite3.Connection:
    if str(path) != ":memory:":
        Path(path).parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(path), check_same_thread=False)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


def init_db(conn: sqlite3.Connection) -> None:
    conn.executescript(SCHEMA)
    conn.commit()


@contextmanager
def open_db(path: str | Path) -> Iterator[sqlite3.Connection]:
    conn = connect(path)
    try:
        init_db(conn)
        yield conn
    finally:
        conn.close()


class ProdukRepository:
    """CRUD operations for the ``produk`` table. Rows are returned as plain dicts."""

    def __init__(self, conn: sqlite3.Connection):
        self.conn = conn

    def find(self, q: str | None = None, limit: int = 50, offset: int = 0) -> list[dict[str, Any]]:
        sql = "SELECT * FROM produk"
        params: list[Any] = []
        if q:
            sql += " WHERE nama LIKE ? OR deskripsi LIKE ?"
            params += [f"%{q}%", f"%{q}%"]
        sql += " ORDER BY id LIMIT ? OFFSET ?"
        params += [limit, offset]
        return [dict(r) for r in self.conn.execute(sql, params)]

    def count(self, q: str | None = None) -> int:
        if q:
            row = self.conn.execute(
                "SELECT COUNT(*) FROM produk WHERE nama LIKE ? OR deskripsi LIKE ?",
                (f"%{q}%", f"%{q}%"),
            ).fetchone()
        else:
            row = self.conn.execute("SELECT COUNT(*) FROM produk").fetchone()
        return int(row[0])

    def get(self, produk_id: int) -> dict[str, Any] | None:
        row = self.conn.execute("SELECT * FROM produk WHERE id = ?", (produk_id,)).fetchone()
        return dict(row) if row else None

    def create(self, data: dict[str, Any]) -> dict[str, Any]:
        now = _now()
        values = {k: data.get(k) for k in FIELDS}
        values["stok"] = values["stok"] or 0
        cur = self.conn.execute(
            "INSERT INTO produk (nama, deskripsi, harga, stok, dibuat, diperbarui) "
            "VALUES (:nama, :deskripsi, :harga, :stok, :dibuat, :diperbarui)",
            {**values, "dibuat": now, "diperbarui": now},
        )
        self.conn.commit()
        return self.get(int(cur.lastrowid))  # type: ignore[return-value]

    def update(self, produk_id: int, data: dict[str, Any]) -> dict[str, Any] | None:
        changes = {k: v for k, v in data.items() if k in FIELDS}
        if not self.get(produk_id):
            return None
        if changes:
            assignments = ", ".join(f"{k} = :{k}" for k in changes)
            self.conn.execute(
                f"UPDATE produk SET {assignments}, diperbarui = :diperbarui WHERE id = :id",
                {**changes, "diperbarui": _now(), "id": produk_id},
            )
            self.conn.commit()
        return self.get(produk_id)

    def delete(self, produk_id: int) -> bool:
        cur = self.conn.execute("DELETE FROM produk WHERE id = ?", (produk_id,))
        self.conn.commit()
        return cur.rowcount > 0
